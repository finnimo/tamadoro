<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context="io.github.finnimo.tamadoro.activities.MainActivity">

<!-- TODO: Update blank fragment layout -->
    <TextView
        android:id="@+id/taskNameTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TASK NAME"
        android:textSize="30dp"/>

    <TextView
        android:id="@+id/taskDescTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TASK DESC"
        android:textSize="30dp"
        app:layout_constraintTop_toBottomOf="@+id/taskNameTemp"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/newTaskBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="new task"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>